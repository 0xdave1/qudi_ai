# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==========================================
# NEON POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Persistent database connection string from your Neon console (https://console.neon.tech)
# Pooled connection recommended for normal application traffic:
# e.g. postgresql://user:password@ep-cool-butterfly-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-project-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (optional, used for DDL migrations):
# e.g. postgresql://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://user:password@ep-project.region.aws.neon.tech/neondb?sslmode=require"

